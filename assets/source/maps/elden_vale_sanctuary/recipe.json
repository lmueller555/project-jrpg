        642
      ],
      "description": "An old arch marks the way into the sanctuary reserve. The woodland path leads back to Elden Vale."
    },
    {
      "id": "sanctuary_hall",
      "name": "Sanctuary Hall",
      "position": [
        535,
        345
      ],
      "description": "The pale stone hall and sheltered cloister are kept for visitors, quiet company and the care of the reserve."
    },
    {
      "id": "memorial_grove",
      "name": "Memorial Grove",
      "position": [
        264,
        306
      ],
      "description": "Old trees and young plantings grow together. Neighbours tend this living grove in remembrance of those they have lost."
    },
    {
      "id": "confluence",
      "name": "Grove Clearing",
      "position": [
        280,
        218
      ],
      "description": "Faint lights drift between the leaves where the vale’s natural aether currents gather."
    },
    {
      "id": "cave",
      "name": "Ridge Cave",
      "position": [
        1008,
        371
      ],
      "description": "Roots cling to a natural opening in the limestone ridge. Weathered traces of masonry remain beside it. A rope closes the entrance while the inner path is checked."
    },
    {
      "id": "stone_seam",
      "name": "Surveyed Stone Face",
      "position": [
        934,
        558
      ],
      "description": "Survey stakes mark an intact limestone seam within the protected reserve, away from the sanctuary hall. No stone has been cut here."
    }
