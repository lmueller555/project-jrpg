            540,
            375
          ]
        },
        {
          "id": "clerk",
          "pose": "stand_left",
          "position": [
            705,
            385
          ]
        }
      ],
      "dialogue": [
        {
          "speaker": "local",
          "text": "My lord? A moment, if you can spare it."
        },
        {
          "speaker": "aldric",
          "text": "Of course."
        },
        {
          "speaker": "local",
          "text": "They said you were coming to look at the road. Are they saying when we'll have our bridge back?"
        },
        {
          "speaker": "aldric",
          "text": "Not yet. I need to see what the crews are working with before I give you a date."
        },
        {
          "speaker": "local",
          "text": "*lets out a frustrated breath* We've had enough dates already."
        },
        {
          "speaker": "aldric",
          "text": "Then I won't give you another one today."
        },
        {
          "speaker": "local",
          "text": "It's the hauling. Every load takes longer, and there are fewer carts to share."
        },
        {
          "speaker": "aldric",
          "text": "What has been getting through?"
        },
        {
          "speaker": "local",
          "text": "Some supplies. Enough lamp oil for the festival, at least. It's the next few loads I'm worried about."
        },
        {
          "speaker": "aldric",
          "text": "Were you here when it happened?"
        }
      ]
    },
    {
      "id": "bridge_damage",
      "scene": "riverbank",
      "min_seconds": 2.2,
      "camera": {
        "from": [
          35,
          55
        ],
        "to": [
          125,
          70
        ]
      },
      "actors": [],
      "dialogue": [
        {
          "speaker": "local",
          "text": "*quietly* I saw the flash from the fields. By the time I reached the bank, the middle of the bridge was gone."
        },
        {
          "speaker": "local",
          "text": "It had split the road on both sides. Stone all over the water."
        },
        {
          "speaker": "aldric",
          "text": "We've seen damage like this elsewhere. I wish I could tell you why."
        }
      ]
    },
    {
      "id": "relief",
      "scene": "riverbank",
      "min_seconds": 1.0,
      "camera": {
        "from": [
          320,
          140
        ],
        "to": [
          320,
          140
        ]
      },
      "actors": [
        {
          "id": "aldric",
          "pose": "gesture_left",
          "position": [
            635,
            375
          ]
        },
        {
          "id": "local",
          "pose": "stand_right",
          "position": [
            540,
            375
          ]
        },
        {
          "id": "clerk",
          "pose": "read_left",
          "position": [
            705,
            385
          ]
        }
      ],
      "dialogue": [
        {
          "speaker": "local",
          "text": "Elsewhere? I thought we had been unlucky."
        },
        {
          "speaker": "aldric",
          "text": "So did the people I visited before coming here. There have been a few such incidents."
        },
        {
          "speaker": "local",
          "text": "And every place needs the same stone and carts."
        },
        {
          "speaker": "aldric",
          "text": "*nods* Yes. That's part of what I've come to discuss."
        },
        {
          "speaker": "aldric",
          "text": "Tell my clerk which deliveries are waiting. The crew needs to know what people are still trying to get through."
        },
        {
          "speaker": "clerk",
          "text": "I can take that down now."
        },
        {
          "speaker": "local",
          "text": "Thank you. I know ours isn't the only road."
        },
        {
          "speaker": "aldric",
          "text": "It's still the one you need. Thank you for stopping me."
        }
      ]
    },
