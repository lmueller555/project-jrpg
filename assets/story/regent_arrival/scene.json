      ],
      "dialogue": [
        {
          "speaker": "guard",
          "text": "Regent Aldric. We were beginning to watch for you."
        },
        {
          "speaker": "aldric",
          "text": "Have we kept you long?"
        },
        {
          "speaker": "guard",
          "text": "Only since the last wagon came in. You came by the ridge road, my lord?"
        },
        {
          "speaker": "aldric",
          "text": "We did. Your warning reached us before the turning."
        },
        {
          "speaker": "guard",
          "text": "A longer journey, then."
        },
        {
          "speaker": "aldric",
          "text": "*with a tired smile* A better one than finding the crossing ourselves."
        },
        {
          "speaker": "guard",
          "text": "The approach is clear. Mother Serene is expecting you."
        },
        {
          "speaker": "aldric",
          "text": "Thank you. And keep someone at the barrier. We can find our way from here."
        }
      ]
    },
