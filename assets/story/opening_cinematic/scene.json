  "dialogue": [
    {
      "start": 24.0,
      "end": 30.0,
      "speaker": "Mira",
      "text": "Here. While it’s warm."
    },
    {
      "start": 32.0,
      "end": 38.0,
      "speaker": "Caelan",
      "text": "I was thinking about the mill."
    },
    {
      "start": 40.0,
      "end": 45.0,
      "speaker": "Mira",
      "text": "The mill?"
    },
    {
      "start": 47.0,
      "end": 56.0,
      "speaker": "Caelan",
      "text": "How certain we were that we could put things right."
    },
    {
      "start": 58.0,
      "end": 65.0,
      "speaker": "Mira",
      "text": "*sits beside him* I wasn’t certain."
    },
    {
      "start": 67.0,
      "end": 75.0,
      "speaker": "Caelan",
      "text": "*looks at her* You could have mentioned that."
    },
    {
      "start": 77.0,
      "end": 87.0,
      "speaker": "Mira",
      "text": "*a tired smile* You were nervous enough already."
    },
    {
      "start": 90.0,
      "end": 97.0,
      "speaker": "Caelan",
      "text": "I thought we’d had a difficult day."
    },
    {
      "start": 99.0,
      "end": 104.0,
      "speaker": "Mira",
      "text": "We had."
    },
    {
      "start": 109.0,
      "end": 113.0,
      "speaker": "Mira",
      "text": "Ready?"
    },
    {
      "start": 115.0,
      "end": 120.0,
      "speaker": "Caelan",
      "text": "Give me a moment."
    }
