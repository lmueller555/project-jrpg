      "lines": [
        {
          "speaker": "arrival_caretaker",
          "text": "Your men said the ground had already been placed under the Crown."
        },
        {
          "speaker": "aldric",
          "text": "They were acting on my orders."
        },
        {
          "speaker": "arrival_caretaker",
          "text": "Mother Serene gave no agreement."
        },
        {
          "speaker": "aldric",
          "text": "No. She did not."
        },
        {
          "speaker": "aldric",
          "text": "There’ll be no more work here. Tell me what you need for the injured."
        },
        {
          "speaker": "arrival_caretaker",
          "text": "Clean water, cloths, and room to work. Keep the path to the hall clear."
        },
        {
          "speaker": "aldric",
          "text": "We’ll keep it clear."
        }
      ],
      "poses": {
