      "lines": [
        {
          "speaker": "mira",
          "text": "That will hold. Keep the arm supported; I’ll leave the cloths here."
        },
        {
          "speaker": "mira",
          "text": "Is the footing at the entrance loose?"
        },
        {
          "speaker": "arrival_caretaker",
          "text": "There’s fallen stone. We couldn’t reach the man safely."
        },
        {
          "speaker": "lucan",
          "text": "Show me exactly where you heard him."
        },
        {
          "speaker": "caelan",
          "text": "Then I’m going with you."
        },
        {
          "speaker": "lucan",
          "text": "You two stay here."
        },
        {
          "speaker": "caelan",
          "text": "We came to help bring them back."
        },
        {
          "speaker": "mira",
          "text": "If he’s trapped under something, you’ll need more than a sword. I have the tools."
        },
        {
          "speaker": "lucan",
          "text": "Then you stay behind me until we know what’s ahead."
        }
      ],
