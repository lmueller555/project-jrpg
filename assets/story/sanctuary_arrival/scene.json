      "lines": [
        {
          "speaker": "caelan",
          "text": "Mother Serene sent us. A man reached Eldenmere.",
          "id": "arrival_contact.0"
        },
        {
          "speaker": "arrival_caretaker",
          "text": "He made it?",
          "id": "arrival_contact.1"
        },
        {
          "speaker": "caelan",
          "text": "She’s looking after him. Where do you need us?",
          "id": "arrival_contact.2"
        },
        {
          "speaker": "arrival_caretaker",
          "text": "Here, first. We brought these two clear of the cave.",
          "id": "arrival_contact.3"
        },
        {
          "speaker": "mira",
          "text": "Let me see that dressing. Keep your arm still for a moment.",
          "id": "arrival_contact.4",
          "action": "treat"
        },
        {
          "speaker": "arrival_worker",
          "text": "All right. Thank you.",
          "id": "arrival_contact.5"
        }
