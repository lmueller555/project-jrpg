        ]
      },
      "lines": [
        {
          "speaker": "arrival_caretaker",
          "text": "Your men claimed this ground for the Crown. Mother Serene gave no agreement.",
          "id": "responsibility.0"
        },
        {
          "speaker": "aldric",
          "text": "They had my orders, without her agreement.",
          "id": "responsibility.1"
        },
        {
          "speaker": "aldric",
          "text": "There’ll be no more work here. What do you need for the injured?",
          "id": "responsibility.2"
        },
        {
          "speaker": "arrival_caretaker",
          "text": "Clean water and cloths. Keep the path to the hall clear.",
          "id": "responsibility.3"
        }
      ],
      "poses": {
