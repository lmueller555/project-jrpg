      "lines": [
        {
          "speaker": "lucan",
          "text": "Who haven’t you found?"
        },
        {
          "speaker": "arrival_caretaker",
          "text": "One of the workers. The creature pulled him back into the cave."
        },
        {
          "speaker": "lucan",
          "text": "Did anyone hear him afterward?"
        },
        {
          "speaker": "arrival_caretaker",
          "text": "He answered when we called. I heard him again before you came through the arch."
        },
        {
          "speaker": "regent_clerk",
          "text": "I have the crew list. Show me who is here."
        },
        {
          "speaker": "aldric",
          "text": "Bring it here. We’ll account for everyone."
