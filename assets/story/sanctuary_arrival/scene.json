          702,
          402
        ],
        "lucan": [
          858,
          414
        ]
      },
      "lines": [
        {
          "speaker": "mira",
          "text": "That will hold. Keep the arm supported; I’ll leave the cloths here.",
          "id": "rescue_decision.0",
          "after": "retrieve"
        },
        {
          "speaker": "arrival_caretaker",
          "text": "There’s fallen stone. We couldn’t reach the man safely.",
          "id": "rescue_decision.1"
        },
        {
          "speaker": "lucan",
          "text": "Show me where you heard him.",
          "id": "rescue_decision.2"
        },
        {
          "speaker": "lucan",
          "text": "You two stay here.",
          "id": "rescue_decision.3"
        },
        {
          "speaker": "caelan",
          "text": "We came to help bring them back.",
          "id": "rescue_decision.4"
        },
        {
          "speaker": "mira",
          "text": "If he’s trapped, you’ll need more than a sword. I have the tools.",
          "id": "rescue_decision.5"
        },
        {
          "speaker": "lucan",
          "text": "Then you stay behind me until we know what’s ahead.",
          "id": "rescue_decision.6"
        }
      ],
