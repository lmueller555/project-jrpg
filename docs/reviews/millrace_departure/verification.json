  "dialogue_pages": [
    {
      "time": 16.5,
      "script": "mill_diagnosis",
      "page": 0,
      "text": "The wheel isn\u2019t getting enough water to turn under load. Something\u2019s restricting the intake.",
      "hold_seconds": 5.067
    },
    {
      "time": 21.55,
      "script": "mill_diagnosis",
      "page": 1,
      "text": "A branch, perhaps?",
      "hold_seconds": 1.8
    },
    {
      "time": 23.35,
      "script": "mill_diagnosis",
      "page": 2,
      "text": "Could be. We\u2019ll know when we see it.",
      "hold_seconds": 3.067
    },
    {
      "time": 26.4,
      "script": "mill_diagnosis",
      "page": 3,
      "text": "We\u2019ll need the upper path.",
      "hold_seconds": 2.067
    },
    {
      "time": 28.45,
      "script": "mill_diagnosis",
      "page": 4,
      "text": "Back over the upper bridge, then north past the sanctuary steps. Take the road out of the village\u2014the intake\u2019s along that trail.",
      "hold_seconds": 7.733
    },
    {
      "time": 36.2,
      "script": "mill_diagnosis",
      "page": 5,
      "text": "All right. Let\u2019s see what\u2019s caught there.",
      "hold_seconds": 2.733
    },
    {
      "time": 38.95,
      "script": "mill_warning",
      "page": 0,
      "text": "Before we go\u2014stay close on the river path. Monsters come down to the water.",
      "hold_seconds": 5.067
    },
    {
      "time": 44.0,
      "script": "mill_warning",
      "page": 1,
      "text": "Close enough to the intake?",
      "hold_seconds": 2.067
    },
    {
      "time": 46.05,
      "script": "mill_warning",
      "page": 2,
      "text": "Sometimes. Most keep their distance.",
      "hold_seconds": 2.067
    },
    {
      "time": 48.1,
      "script": "mill_warning",
      "page": 3,
      "text": "And the others?",
      "hold_seconds": 1.8
    },
    {
      "time": 49.9,
      "script": "mill_warning",
      "page": 4,
      "text": "*checks the spearhead* I\u2019d rather have this with me.",
      "hold_seconds": 3.4
    },
    {
      "time": 53.3,
      "script": "mill_warning",
      "page": 5,
      "text": "I wasn\u2019t planning to go farther than Halden\u2019s yard today.",
      "hold_seconds": 3.733
    },
    {
      "time": 57.05,
      "script": "mill_warning",
      "page": 6,
      "text": "Neither was I. Here\u2014take the tool roll. We\u2019ll keep to the open bank.",
      "hold_seconds": 4.733
    },
    {
      "time": 61.8,
      "script": "mill_warning",
      "page": 7,
      "text": "All right. North past the sanctuary steps, then.",
      "hold_seconds": 3.067
    }
  ],
