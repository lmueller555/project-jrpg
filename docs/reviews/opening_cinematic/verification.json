  "dialogue_lines": 30,
  "observed_dialogue": [
    {
      "index": 0,
      "id": "warm_cup",
      "speaker": "Mira",
      "text": "Here. While it\u2019s warm.",
      "first_seen": 24.0,
      "last_seen": 27.1667
    },
    {
      "index": 1,
      "id": "thanks",
      "speaker": "Caelan",
      "text": "Thanks, Mira",
      "first_seen": 28.2,
      "last_seen": 30.7667
    },
    {
      "index": 2,
      "id": "shaking_hands",
      "speaker": "Mira",
      "text": "Your hands are still shaking. Mine too.",
      "first_seen": 31.8,
      "last_seen": 36.0667
    },
    {
      "index": 3,
      "id": "hands_will_stop",
      "speaker": "Caelan",
      "text": "It'll be ok, they'll stop once we get moving.",
      "first_seen": 37.1,
      "last_seen": 42.2667
    },
    {
      "index": 4,
      "id": "miras_hands",
      "speaker": "Mira",
      "text": "I hope you're right.",
      "first_seen": 43.3,
      "last_seen": 46.5
    },
    {
      "index": 5,
      "id": "entrance",
      "speaker": "Caelan",
      "text": "How far to the entrance?",
      "first_seen": 47.5333,
      "last_seen": 51.0
    },
    {
      "index": 6,
      "id": "ridge",
      "speaker": "Mira",
      "text": "Beyond the ridge. There\u2019s some climbing yet.",
      "first_seen": 52.0333,
      "last_seen": 56.3
    },
    {
      "index": 7,
      "id": "can_manage",
      "speaker": "Caelan",
      "text": "I can manage.",
      "first_seen": 57.3333,
      "last_seen": 60.1
    },
    {
      "index": 8,
      "id": "rest",
      "speaker": "Mira",
      "text": "I know. But you need to rest a bit first.",
      "first_seen": 61.1333,
      "last_seen": 66.5
    },
    {
      "index": 9,
      "id": "valley_houses",
      "speaker": "Caelan",
      "text": "You know, there are still people in those houses.",
      "first_seen": 67.5333,
      "last_seen": 72.7
    },
    {
      "index": 10,
      "id": "evacuation",
      "speaker": "Mira",
      "text": "Yeah...but the caravan is going back for another group. They will make it out...I hope.",
      "first_seen": 73.7333,
      "last_seen": 82.0
    },
    {
      "index": 11,
      "id": "opposite_direction",
      "speaker": "Caelan",
      "text": "And when we leave here, we\u2019re going the other way. It feels like we're turning our back on them.",
      "first_seen": 83.0333,
      "last_seen": 92.0
    },
    {
      "index": 12,
      "id": "surge",
      "speaker": "Mira",
      "text": "Maybe...but another surge like that could wipe out the whole valley. We need to reach the source so we can put an end to this.",
      "first_seen": 93.0333,
      "last_seen": 104.6
    },
    {
      "index": 13,
      "id": "promise",
      "speaker": "Caelan",
      "text": "I'm scared, Mira. We've come so far, but we still have so far left to go.",
      "first_seen": 105.6333,
      "last_seen": 113.6
    },
    {
      "index": 14,
      "id": "first_carts",
      "speaker": "Mira",
      "text": "It's ok, Caelan, I'm scared too. But I believe in you!",
      "first_seen": 114.6333,
      "last_seen": 120.7
    },
    {
      "index": 15,
      "id": "mill_memory",
      "speaker": "Caelan",
      "text": "Mira...I was thinking about the mill.",
      "first_seen": 121.7333,
      "last_seen": 126.1
    },
    {
      "index": 16,
      "id": "halden",
      "speaker": "Mira",
      "text": "Halden\u2019s?",
      "first_seen": 127.1333,
      "last_seen": 129.7
    },
    {
      "index": 17,
      "id": "small_spell",
      "speaker": "Caelan",
      "text": "Do you remember when I barely managed to clear that little recess? Would you ever have guessed we'd look back on that as the least of our troubles?",
      "first_seen": 130.7333,
      "last_seen": 143.0
    },
    {
      "index": 18,
      "id": "useful_spell",
      "speaker": "Mira",
      "text": "*laughs* Ha...yeah that seems like a lifetime ago now. But, Caelan?",
      "first_seen": 144.0333,
      "last_seen": 150.4
    },
    {
      "index": 19,
      "id": "told_me",
      "speaker": "Caelan",
      "text": "What?",
      "first_seen": 151.4333,
      "last_seen": 154.0
    },
    {
      "index": 20,
      "id": "meant_it",
      "speaker": "Mira",
      "text": "I know what else you're thinking about. I want you to know he's just as proud of you as I am.",
      "first_seen": 155.0333,
      "last_seen": 164.6
    },
    {
      "index": 21,
      "id": "nervous",
      "speaker": "Caelan",
      "text": "...thanks. I'm feeling better...lighter.",
      "first_seen": 167.7333,
      "last_seen": 171.5
    },
    {
      "index": 22,
      "id": "understood_problem",
      "speaker": "Mira",
      "text": "Your hands stopped shaking. Mine too...I'm ready.",
      "first_seen": 174.0667,
      "last_seen": 178.8333
    },
    {
      "index": 23,
      "id": "catch_and_branch",
      "speaker": "Caelan",
      "text": "This lamp...we'll leave it here. Mira, think you can you work your magic with it?",
      "first_seen": 179.8667,
      "last_seen": 187.8333
    },
    {
      "index": 24,
      "id": "two_of_us",
      "speaker": "Mira",
      "text": "Leave it to me! This beacon will guide the evacuation to safety.",
      "first_seen": 188.8667,
      "last_seen": 195.0333
    },
    {
      "index": 25,
      "id": "simple_again",
      "speaker": "Caelan",
      "text": "This should help too.",
      "first_seen": 196.0667,
      "last_seen": 199.2333
    },
    {
      "index": 26,
      "id": "so_do_i",
      "speaker": "Mira",
      "text": "Ok there! Don't break on me now.",
      "first_seen": 212.3667,
      "last_seen": 216.6333
    },
    {
      "index": 27,
      "id": "going_in",
      "speaker": "Caelan",
      "text": "Huh? Me? Or the lamp?",
      "first_seen": 217.6667,
      "last_seen": 221.1333
    },
    {
      "index": 28,
      "id": "when_ready",
      "speaker": "Mira",
      "text": "*smiles* Let's go.",
      "first_seen": 222.1667,
      "last_seen": 224.9333
    },
    {
      "index": 29,
      "id": "one_moment",
      "speaker": "Caelan",
      "text": "Indeed.",
      "first_seen": 225.9667,
      "last_seen": 228.5333
    }
  ],
